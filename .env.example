BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DB_URL=postgresql+asyncpg://user:password@db:5432/gamingbot
# Telegram supergroup id — MUST be the negative -100… form (not the positive id!)
GROUP_ID=-1001234567890
ADMIN_IDS=123456789,987654321
# Alert al maintainer: ogni problema che il bot logga a questo livello o sopra
# arriva in privato agli ADMIN_IDS. CRITICAL = praticamente spento.
# Riceve solo chi ha gia' avviato il bot in privato.
ALERT_MIN_LEVEL=WARNING
DAILY_REWARD_COINS=100
# /daily si azzera a mezzanotte locale (SCHEDULER_TIMEZONE); questo è il gap
# minimo aggiuntivo dall'ultima riscossione (in AND con la mezzanotte, così un
# claim alle 23:59 non ne consente un altro alle 00:01). Deve stare fra 1 e 23:
# oltre le 24h il claim successivo può finire dopo un giorno intero e costare la
# streak. Ora è imposto dai vincoli, non solo scritto qui.
DAILY_MIN_HOURS=6
# memory | redis. Con `redis` il bot fa un ping all'avvio: se non risponde,
# logga un warning e riparte in memoria invece di non partire (STEERING §2).
FSM_STORAGE=redis
REDIS_URL=redis://redis:6379/0
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_MODEL=qwen/qwen3.6-27b           # entertainment commands
# GROQ_REASONING_EFFORT=none            # qwen3.6 is hybrid-reasoning: without this it writes
#                                       # its chain of thought into the reply. Empty = omitted.
# GROQ_JUDGE_MODEL=openai/gpt-oss-120b  # guess games: needs strict structured output
# Persistent AI games (currently 20 Domande). Structured output is mandatory.
# Without a provider, 20 Domande cannot classify new questions.
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_THINKING_LEVEL=medium           # default future strategies; 20 Domande forces minimal
# GEMINI_TIMEOUT_SECONDS=20
# Conversational Alduino. Independent from the structured games above: Gemini
# gets only the invoked reply branch + public event state, never the whole chat.
# ALDUINO_PROVIDER=gemini                 # gemini | groq
# ALDUINO_GEMINI_MODEL=gemini-3.6-flash
# ALDUINO_THINKING_LEVEL=minimal          # fast/cheap for short group replies
# ALDUINO_FALLBACK_TO_GROQ=true           # continuity during Gemini outages
# ALDUINO_TIMEOUT_SECONDS=15
# ALDUINO_HISTORY_TURNS=10                # recent user/Alduino pairs per branch
# ALDUINO_HISTORY_CHARS=8000              # second, hard local-context bound
# ALDUINO_MEMORY_ROWS_PER_GROUP=1000      # storage cap; oldest rows are pruned
# AI_GAME_CLAIM_TIMEOUT_SECONDS=45       # reclaim a turn after a crashed worker (min 5)
# IGDB: primary cached catalog for 20 Domande. Create a free confidential app at
# https://dev.twitch.tv/console/apps (non-commercial use); empty = built-in fallback.
# IGDB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# IGDB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# IGDB_CATALOG_SIZE=300                   # top N main games by rating-count (50..2000)
# IGDB_MIN_RATING_COUNT=100               # reject obscure titles before the top-N cap
# IGDB_MIN_CATALOG_ENTRIES=50             # never replace a healthy cache below this floor
# IGDB_SYNC_INTERVAL_HOURS=24
# IGDB_TIMEOUT_SECONDS=20
# XP progression (merit metric, separate from coins). XP is gained from admin
# events (quiz) uncapped + a small capped daily participation quota (anti-farm).
# CATALOG_DIR=data                    # dir with optional trophies/ranks/shop_cosmetics CSVs
# XP_DAILY_PARTICIPATION_CAP=50       # max farmable XP per user per day
# XP_PER_DAILY_CLAIM=10               # capped XP on /daily
# XP_PER_BET_WON=15                   # capped XP on a winning bet
# XP_LEVEL_BASE=100                   # XP to go from level 1 → 2 (min 1)
# XP_LEVEL_GROWTH=1.15                # each level costs +15% more than the previous
#   ⚠️ GROWTH deve essere >= 1.0 e BASE >= 1: un valore piu' basso fa decadere il
#   costo per livello a 0 e la ricerca del livello non termina piu' — l'event loop
#   si blocca e il bot smette di rispondere. Il bot rifiuta di partire, non ci arriva.

# Anti-spam (on top of the global 12/10s rate-limit middleware) & cosmetics.
# AI_COOLDOWN_SECONDS=60              # 1 AI command / N s per non-admin
# COMMAND_COOLDOWN_SECONDS=3          # heavier user commands (classifiche, negozio…)
# EVENT_CREATE_COOLDOWN_SECONDS=5     # starting a quiz/poll/bet creation flow
# MAX_ACTIVE_TAGS=3                   # shop tags a user can keep active at once

# Scheduler (programmed quiz/poll/bet). Times entered AND shown to admins use this
# timezone (DB stores UTC). Any IANA name; default Rome (CET/CEST = UTC+1/+2).
# SCHEDULER_TIMEZONE=Europe/Rome
# SCHEDULER_POLL_INTERVAL=20          # seconds between due-task checks (min 1: 0 = hot loop)

# Backup & state export (§25). All optional — defaults shown.
# In Docker the backups live in the named volume `bot_backups` (owned by the
# container's botuser → no host-bind EACCES); retrieve via /backup·/esporta DM.
# BACKUP_DIR=backups                  # where snapshots + the chat archive live
# BACKUP_STATE_INTERVAL_HOURS=24      # auto state export cadence
# BACKUP_STATE_KEEP=5                 # rotated state snapshots to keep (min 1: 0 li cancella tutti)
# BACKUP_CHAT_INTERVAL_HOURS=168      # auto chat-archive cadence (weekly)
# BACKUP_MAX_MESSAGE_CHARS=4096       # per-message text cap in the archive
# /backup chat archive via MTProto (the Bot API can't read history). Leave empty
# to disable. api_id/api_hash: https://my.telegram.org → API development tools.
# TELEGRAM_SESSION: a SENSITIVE full-account credential — generate it once with
# `python scripts/login_telethon.py`, never commit it. Use a dedicated account.
# TELEGRAM_API_ID=1234567
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# TELEGRAM_SESSION=

# Optional: use the image published by CI instead of building locally.
# BOT_IMAGE=ghcr.io/<your-gh-username>/gaming-community-bot:latest
