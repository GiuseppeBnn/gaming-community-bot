BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DB_URL=postgresql+asyncpg://user:password@db:5432/gamingbot
# Telegram supergroup id — MUST be the negative -100… form (not the positive id!)
GROUP_ID=-1001234567890
ADMIN_IDS=123456789,987654321
DAILY_REWARD_COINS=100
FSM_STORAGE=redis
REDIS_URL=redis://redis:6379/0
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# XP progression (merit metric, separate from coins). XP is gained from admin
# events (quiz) uncapped + a small capped daily participation quota (anti-farm).
# CATALOG_DIR=data                    # dir with optional trophies/ranks/shop_cosmetics CSVs
# XP_DAILY_PARTICIPATION_CAP=50       # max farmable XP per user per day
# XP_PER_DAILY_CLAIM=10               # capped XP on /daily
# XP_PER_BET_WON=15                   # capped XP on a winning bet

# Optional: use the image published by CI instead of building locally.
# BOT_IMAGE=ghcr.io/<your-gh-username>/gaming-community-bot:latest
